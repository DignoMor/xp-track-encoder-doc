{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://track-encoder.dev/schemas/dilated-cnn-hp.schema.json",
  "title": "Dilated CNN reconstruction hyperparameters",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "architecture", "objective", "optimizer", "training"],
  "properties": {
    "schema_version": {"const": 1},
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layers", "embedding_dim"],
      "properties": {
        "layers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["channels", "kernel_size", "dilation", "resolution_bp"],
            "properties": {
              "channels": {"type": "integer", "minimum": 1},
              "kernel_size": {"type": "integer", "minimum": 1},
              "dilation": {"type": "integer", "minimum": 1},
              "resolution_bp": {"type": "integer", "minimum": 1}
            }
          }
        },
        "embedding_dim": {"type": "integer", "minimum": 1}
      }
    },
    "objective": {
      "type": "object",
      "additionalProperties": false
    },
    "optimizer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["learning_rate", "weight_decay"],
      "properties": {
        "learning_rate": {"type": "number", "exclusiveMinimum": 0},
        "weight_decay": {"type": "number", "minimum": 0}
      }
    },
    "training": {
      "type": "object",
      "additionalProperties": false,
      "required": ["batch_size"],
      "properties": {
        "batch_size": {"type": "integer", "minimum": 1}
      }
    }
  }
}
