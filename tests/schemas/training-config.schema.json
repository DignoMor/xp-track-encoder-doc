{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://track-encoder.dev/schemas/training-config.schema.json",
  "title": "Track Encoder training configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "data", "architecture", "objective", "optimizer", "run"],
  "properties": {
    "schema_version": {"const": 3},
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["train_dataset_path", "val_dataset_path"],
      "properties": {
        "train_dataset_path": {"type": "string", "pattern": "^/"},
        "val_dataset_path": {"type": "string", "pattern": "^/"}
      }
    },
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"enum": ["dilated_cnn"]}
      }
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "loss"],
      "properties": {
        "type": {"enum": ["reconstruction"]},
        "loss": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type"],
              "properties": {
                "type": {"const": "mse"}
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type"],
              "properties": {
                "type": {"const": "alignment_tolerant_mse"},
                "max_shift_bp": {
                  "type": "integer",
                  "minimum": 0,
                  "default": 50
                }
              }
            }
          ]
        }
      }
    },
    "optimizer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"enum": ["adamw"]}
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seed", "epochs", "output_dir", "device"],
      "properties": {
        "seed": {"type": "integer", "minimum": 0},
        "epochs": {"type": "integer", "minimum": 1},
        "output_dir": {"type": "string", "pattern": "^/"},
        "device": {"const": "cuda"}
      }
    },
    "tracking": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "project"],
      "properties": {
        "type": {"const": "wandb"},
        "project": {"type": "string", "minLength": 1},
        "entity": {"type": "string", "minLength": 1},
        "run_name": {"type": "string", "minLength": 1}
      }
    }
  }
}
